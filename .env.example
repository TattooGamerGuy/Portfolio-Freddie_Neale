# --- Cloud backend (Azure). Default is local mock data; no real credentials here. ---
# local = existing mock/simulated data (default). azure = Azure services (requires real values below).
CLOUD_PROVIDER=local
# Azure Cosmos DB (NoSQL) or Azure SQL
AZURE_COSMOS_ENDPOINT=https://<cosmos-account>.documents.azure.com:443/
AZURE_COSMOS_DATABASE=portfolio
AZURE_SQL_CONNECTION_STRING=
# Azure Blob Storage
AZURE_STORAGE_ACCOUNT=<storage-account-name>
AZURE_STORAGE_CONTAINER=portfolio-files
# Microsoft Entra ID (auth)
AZURE_TENANT_ID=<tenant-guid>
AZURE_CLIENT_ID=<app-registration-client-id>
AZURE_CLIENT_SECRET=
# Azure Event Hubs (telemetry / domain events)
AZURE_EVENTHUBS_NAMESPACE=<namespace>.servicebus.windows.net
AZURE_EVENTHUB_NAME=portfolio-events
